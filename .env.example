# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Movie storage channel ID (bot must be an Admin in this channel)
# Example: -1001234567890
CHANNEL_ID=-1003379413807

# Bot Administrator Telegram User ID
ADMIN_ID=670167033

# Database file path (default keeps compatibility with existing kinobot.db)
DB_NAME=kinobot.db

# Optional: Path to Netscape-format cookies.txt for yt-dlp (auto-used if file exists)
COOKIES_FILE=cookies.txt

# Anti-ban & rate-limiting settings
DOWNLOAD_COOLDOWN_SECONDS=20
MAX_CONCURRENT_DOWNLOADS=2

# Optional: Explicit path to ffmpeg binary/folder if not in system PATH
FFMPEG_LOCATION=

# Notify admin via private message when a channel movie is saved (true/false)
NOTIFY_ADMIN_ON_CHANNEL_SAVE=true

# Bot API 10.5 — Automatic bot configuration via setMySettings on startup
AUTO_CONFIGURE_BOT_SETTINGS=true
BOT_ENABLE_INLINE=true
BOT_INLINE_PLACEHOLDER=Kino kodini kiriting (masalan: 105)...
BOT_CAN_JOIN_GROUPS=true
BOT_TOPICS_ENABLED=false
BOT_TOPIC_SIDEBAR=false
